<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Version>1.0.1</Version>
		<PackageId>Cancelify</PackageId>
		<Authors>Oguz Kurumlu</Authors>
		<Company>Cancelify</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/oguzkurumlu/Cancelify</PackageProjectUrl>
		<RepositoryUrl>https://github.com/oguzkurumlu/Cancelify</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Description>Distributed cancellation token for .NET using Redis.</Description>
		<PackageTags>cancellation distributed microservices redis rabbitmq kafka</PackageTags>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.58" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cancelify.Core\Cancelify.Core.csproj" />
  </ItemGroup>

</Project>
